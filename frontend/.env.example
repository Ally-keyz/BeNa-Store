# =============================================================================
# BeNa Origins storefront — environment template
# Copy to `.env.local` (gitignored) for local overrides. No secrets ever live
# here: VITE_* values are public by definition and bundled into the client.
# =============================================================================

# Backend REST base. Leave EMPTY (or "/api/v1") to use same-origin requests,
# which the Vite dev proxy forwards to the backend. Set to an absolute URL only
# when the frontend calls the API cross-origin (e.g. a preview deploy without a
# proxy). NEVER put a Shopify token or any secret in a VITE_ variable.
VITE_API_BASE_URL=

# Socket.IO origin. Leave empty for same-origin (dev proxy handles /socket.io).
VITE_SOCKET_URL=

# Canonical public site (used for SEO canonical/JSON-LD links).
VITE_SITE_URL=https://benaorigins.de

# -----------------------------------------------------------------------------
# Public business identity — owner-supplied values already used as defaults.
# These are bundled into the client — never add secrets here.
# -----------------------------------------------------------------------------
VITE_BRAND_NAME=BeNa Origins
VITE_BRAND_LOGO_NAME=BeNa SheGrows Coffee
VITE_LEGAL_NAME=BeNa Store
VITE_CONTACT_EMAIL=store@benaorigins.de
VITE_ORDERS_EMAIL=store@benaorigins.de
VITE_ADDRESS_STREET=Am Galgenköppel 4
VITE_ADDRESS_CITY=34289 Zierenberg
VITE_ADDRESS_COUNTRY=Germany
VITE_BRAND_SLOGAN=Taste of Rwanda

# Social links. The WhatsApp value is the direct destination of the
# Instagram link-in-bio invite (no tracking redirect needed).
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/benaorigins/
VITE_SOCIAL_WHATSAPP=https://chat.whatsapp.com/CndIu3wGBVgJsgi7Q6Q6Xi
