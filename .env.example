# =============================================================================
# BeNa Origins backend — environment template
# Copy to `.env` (gitignored) and fill in. Never commit real secrets.
# Values below are safe defaults; anything marked SECRET must stay server-side.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated allow-list. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Public base URL of THIS backend (OpenAPI servers, snippets). Use "/" locally.
API_PUBLIC_URL=
# The future React storefront origin (used for canonical links / SEO)
FRONTEND_URL=http://localhost:5173
# Public production storefront (used for canonical URLs and review detection)
SITE_URL=https://benaorigins.de
SITE_NAME=BeNa Origins

LOG_LEVEL=info
# true for human-readable logs (dev only)
LOG_PRETTY=true
# Set when behind a reverse proxy/load balancer (Express `trust proxy`)
TRUST_PROXY=1

# --- Shopify: core ---------------------------------------------------------
# xxx.myshopify.com  (Admin > Settings > Domains > "myshopify.com" domain)
SHOPIFY_STORE_DOMAIN=www.benaorigins.de
# Latest stable at time of writing. Override deliberately, never guess.
SHOPIFY_API_VERSION=2026-10

# Storefront API tokens (at least ONE is required for metafields/tags/inventory)
# Public token: used for buyer-scoped traffic (X-Shopify-Storefront-Access-Token)
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Private token: server-side only (Shopify-Storefront-Private-Token). PREFERRED.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# auto = fixture mode when no storefront token is present; true = always fixtures
SHOPIFY_MOCK_MODE=auto

# --- Shopify: webhooks -----------------------------------------------------
# Custom app "API secret key" OR the signing secret of webhooks created in
# Settings > Notifications. HMAC-SHA256 over the RAW request body.
SHOPIFY_WEBHOOK_SECRET=
# Public HTTPS URL that Shopify can reach (tunnel in dev, e.g.
# cloudflared tunnel --url http://localhost:4000 / ngrok http 4000)
PUBLIC_WEBHOOK_BASE_URL=
# Comma separated topics the registration script should manage.
SHOPIFY_WEBHOOK_TOPICS=ORDERS_CREATE,ORDERS_UPDATED,ORDERS_FULFILLED,PRODUCTS_UPDATE,INVENTORY_LEVELS_UPDATE,APP_UNINSTALLED

# Admin API token, used ONLY by the webhook registration script (never at runtime)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-10
# Set to true ONLY when you intend to actually call Shopify (script refuses
# without --apply; this flag is an extra guard for CI).
SHOPIFY_WEBHOOKS_APPLY=false
# --- Internal / audit endpoints (Layer 2, mandatory) ----------------------
# Hash an admin key at rest. Generate a key, then its hash:
#   node -e "const c=require('crypto');const k=c.randomBytes(32).toString('hex');console.log('KEY ',k);console.log('HASH',c.createHash('sha256').update(k).digest('hex'))"
# Send requests with:  x-admin-key: <the key>   (the raw key is NOT stored here)
ADMIN_API_KEY_SHA256=
# Plaintext alternative (hashed at startup; less preferred than the hash).
# ADMIN_API_KEY=
# Alternative/complement: HS256 JWT with a role/roles containing "admin".
# Also signs admin Socket.IO tokens. openssl rand -hex 32
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL_SECONDS=3600
# Legacy alias (hashed at startup); prefer ADMIN_API_KEY_SHA256.
ADMIN_API_TOKEN=
AUDIT_PRODUCT_SCAN_LIMIT=250
AUDIT_CACHE_TTL_SECONDS=300
AUDIT_MIN_IMAGES=3
AUDIT_FOOD_KEYWORDS=coffee,juice,syrup,biscuit,margarine,oil,flour,rice,beans,tea,chocolate,snack,food,spice,sauce,drink
# Metafields exposed to the Storefront API (Admin > Settings > Custom data)
SHOPIFY_METAFIELD_NAMESPACES=custom,food
METAFIELD_NUTRITION_KEY=nutrition
METAFIELD_INGREDIENTS_KEY=ingredients
METAFIELD_ALLERGENS_KEY=allergens
METAFIELD_ORIGIN_KEY=origin
METAFIELD_PREPARATION_KEY=preparation

# --- Shipping / markets claims -------------------------------------------
# The public shipping policy claims worldwide delivery (audit finding #7).
SHIPPING_WORLDWIDE_CLAIM=true
# Countries the storefront region selector actually offers (informational
# fallback; live markets are always read from Shopify when available).
SHIPPING_ADVERTISED_COUNTRIES=DE,AT,FR,NL,BE,IT,ES,PT,IE,UK

# --- Customer accounts (Layer 1, feature-flagged) -------------------------
# OFF by default. Guest checkout works fully without this.
AUTH_CUSTOMER_ACCOUNTS_ENABLED=false
AUTH_SESSION_TTL_SECONDS=86400
AUTH_STATE_TTL_SECONDS=600
AUTH_RATE_LIMIT_MAX=10
# openssl rand -hex 32 (server-only)
SESSION_SECRET=
# Optional: share cookie across subdomains. Leave empty for __Host- cookie.
COOKIE_DOMAIN=
# Defaults to true in production; set false only for local HTTP.
COOKIE_SECURE=

# Shopify Customer Account API (Headless channel or custom app).
# New customer accounts must be enabled in Shopify Admin.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=63193325-4e1e-4cbf-a5c3-78523e52f96e
# Only for a confidential client. PKCE is used regardless.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SCOPE=openid email customer-account-api:full
# Discovery is read from the storefront domain; override if needed.
SHOPIFY_CUSTOMER_ACCOUNT_DISCOVERY_URL=
SHOPIFY_CUSTOMER_ACCOUNT_API_DISCOVERY_URL=
# Optional explicit endpoints (copy from the discovery document).
SHOPIFY_CUSTOMER_ACCOUNT_AUTH_URL=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URL=
SHOPIFY_CUSTOMER_ACCOUNT_JWKS_URI=
SHOPIFY_CUSTOMER_ACCOUNT_ISSUER=
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
# Must be registered exactly in Shopify Customer Account API settings.
# Local dev: use an HTTPS tunnel URL (Shopify requires HTTPS).
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URI=
# Must be in Shopify's JavaScript Origin allow-list.
SHOPIFY_CUSTOMER_ACCOUNT_JS_ORIGIN=http://localhost:5173
# Short aliases accepted as fallbacks: CUSTOMER_ACCOUNT_REDIRECT_URI,
# CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URI, CUSTOMER_ACCOUNT_JS_ORIGIN.

# --- Socket.IO ------------------------------------------------------------
# openssl rand -hex 32   (server-side only)
# Fallback for ADMIN_JWT_SECRET (admin API + Socket.IO). Prefer ADMIN_JWT_SECRET.
SOCKET_ADMIN_JWT_SECRET=
SOCKET_ADMIN_TOKEN_TTL_SECONDS=3600
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CART_RATE_LIMIT_MAX=40
NEWSLETTER_RATE_LIMIT_MAX=5
WEBHOOK_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=60

# --- AI product-fact suggestions (free hosted API) ------------------------
# Create a free key at https://console.groq.com/keys — no card, no training and
# no local model server. Leave AI_API_KEY empty to hide the feature entirely.
AI_ENABLED=true
AI_API_KEY=
# OpenAI-compatible endpoint. Defaults to Groq's free tier.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_TEMPERATURE=0.2
# Results are cached in memory; 1 hour keeps the free quota safe.
AI_CACHE_TTL_SECONDS=3600

# --- Optional infrastructure ---------------------------------------------
# Enables Redis-backed webhook dedup and Socket.IO scaling.
# Restock signups do not use Redis; they are stored in process memory only.
REDIS_URL=
# Reserved for future error reporting; not wired in this phase.
SENTRY_DSN=

# --- Newsletter (provider agnostic) --------------------------------------
# mock | webhook | klaviyo | mailchimp
NEWSLETTER_PROVIDER=mock
# webhook provider (Zapier/Make/n8n/custom)
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
# Klaviyo (private API key, starts with pk_)
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
# Klaviyo API revision header (see Klaviyo docs for the current supported date)
KLAVIYO_API_REVISION=2025-01-15
# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# --- Restock notifications (real product-specific alerts) -----------------
# mock logs only (dev default). Use resend to send email directly, or webhook
# to forward a signed event to Zapier/Make/n8n/custom email automation.
RESTOCK_PROVIDER=mock
RESTOCK_RATE_LIMIT_MAX=5
# Pending signups expire after 30 days unless notified first.
RESTOCK_SIGNUP_TTL_SECONDS=2592000
# resend provider
RESTOCK_RESEND_API_KEY=
RESTOCK_FROM_EMAIL=
RESTOCK_REPLY_TO_EMAIL=
# webhook provider
RESTOCK_WEBHOOK_URL=
RESTOCK_WEBHOOK_SECRET=

# --- Reviews app assessment and public reviews ---------------------------
# auto | judge_me | loox | stamped | yotpo | okendo | shopify_product_reviews | none
REVIEWS_PROVIDER=auto
REVIEWS_RATE_LIMIT_MAX=5
# Owner email for new public reviews. Delivery reuses the Restock Resend settings.
REVIEWS_NOTIFICATION_EMAIL=store@benaorigins.de
# Optional explicit token if a provider API is wired later (not used in phase 1)
REVIEWS_API_TOKEN=
# Genuine reviews feed only. Supports {handle} / {HANDLE}; leave empty to report
# "not_configured" honestly. Never invent or fabricate ratings.
REVIEWS_API_URL_TEMPLATE=
REVIEWS_CACHE_TTL_SECONDS=3600

# --- Electronic withdrawal declaration (finding #1) ------------------------
# mock (default, simulated receipt) | webhook (requires URL, optional HMAC secret)
WITHDRAWAL_PROVIDER=mock
WITHDRAWAL_WEBHOOK_URL=
WITHDRAWAL_WEBHOOK_SECRET=
WITHDRAWAL_RATE_LIMIT_MAX=5

# --- Derived catalog facets ------------------------------------------------
FACETS_CACHE_TTL_SECONDS=300
FACETS_SCAN_LIMIT=250

# --- Live Shopify apply scripts (dry-run by default) -----------------------
# Both --apply AND SHOPIFY_LIVE_APPLY=1 are required before any write.
SHOPIFY_LIVE_APPLY=0
